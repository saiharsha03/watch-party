# Copy to .env and fill in. Never commit .env.

# Scoreboard source:
#   cricbuzz      = Cricbuzz match-centre JSON (default; batters, bowlers, overs). Needs CRICBUZZ_MATCH_ID.
#   cricinfo-rss  = ESPNcricinfo live-scores RSS (no key; runs + wickets only)
#   cricketdata   = CricketData.org API (needs CRICKETDATA_API_KEY; free = 100 calls/day)
SCORE_SOURCE=cricbuzz
# The number in the Cricbuzz match URL, e.g. cricbuzz.com/live-cricket-scores/123456/...
CRICBUZZ_MATCH_ID=
# Auto-run the over game, celebrations and pick answers from the Cricbuzz feed
AUTO_GAME=true
# Optional: ESPNcricinfo match id (only used by cricinfo-rss)
CRICINFO_MATCH_ID=
MATCH_TEAM=India
MATCH_OPPONENT=Pakistan
# Auto-celebrate MATCH_TEAM 4s/6s from score jumps (set false if it fires wrongly)
AUTO_BOUNDARIES=true

# Free key from https://cricketdata.org (only used when SCORE_SOURCE=cricketdata)
CRICKETDATA_API_KEY=

# TURN relay: needed when direct video is blocked (cellular / carrier NAT).
# Option A: any TURN provider with a fixed username/password. Comma-separate URLs, e.g.
#   TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Option B: Cloudflare TURN. Used only if TURN_URLS is blank.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# Optional: exact match id from the CricketData API. Blank = find by MATCH_TEAM + MATCH_SERIES.
MATCH_ID=
MATCH_SERIES=Asian Games

# Kickoff in UTC (ISO 8601). Match picks lock at this time; score polling runs from 15 min before to 5 h after.
KICKOFF_UTC=2026-01-01T12:00:00Z

# Blank = source default (Cricbuzz 12 s, Cricinfo 30 s, CricketData 150 s)
POLL_SECONDS=
# Hold score updates back so they don't spoil the stream
SCORE_DELAY_SECONDS=20

# Secret for hosting from any computer: open the tunnel link with #host=<HOST_KEY>.
# At least 12 characters, e.g. `openssl rand -hex 16`. Blank = host only from localhost.
HOST_KEY=

# Admin endpoint key, sent as the X-Admin-Key header. Generate: openssl rand -hex 24
# The admin endpoint refuses everything while this is blank.
ADMIN_KEY=
